{
    "manifest_version": 3,
    "name": "Low-Value Guard: filter out low-value content on your LinkedIn feed using AI",
    "author": "Pankaj Tanwar",
    "version": "0.0.5",
    "description": "AI-powered Chrome extension that filters low-value posts and clickbait from your LinkedIn feed in real-time.",
    "content_scripts": [
        {
            "js": [
                "lib/settings.js",
                "content/feedback.js",
                "content/content.js"
            ],
            "matches": [
                "https://www.linkedin.com/feed/*"
            ],
            "css": [
                "content/content.css"
            ]
        }
    ],
    "background": {
        "service_worker": "build/service_worker.js",
        "type": "module"
    },
    "host_permissions": [
        "https://linkedin-training-512914-3hhrx3osja-ew.a.run.app/*",
        "https://identitytoolkit.googleapis.com/*",
        "https://securetoken.googleapis.com/*"
    ],
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "action": {
        "default_popup": "popup/popup.html",
        "default_title": "Low-Value Guard"
    },
    "options_page": "lib/about.html",
    "permissions": [
        "storage"
    ]
}
