{
  "scripts": {
    "build:extension": "node scripts/build-extension.mjs",
    "test": "npm run test:client && npm run test:ui",
    "test:client": "node --test app/client/background/*.test.js app/client/content/*.test.js app/client/lib/*.test.js",
    "test:server": ".venv/bin/python -m pytest -q app/server",
    "test:training": ".venv/bin/python -m pytest -q app/model_training",
    "build:popup": "ng build popup",
    "test:ui": "npm run build:extension && playwright test",
    "typecheck": "tsc --noEmit -p app/client/tsconfig.json",
    "lint": "eslint app/client scripts/*.mjs *.mjs --max-warnings=0",
    "format": "prettier --write \"app/client/**/*.{js,ts,cjs,mjs,html,css,json}\" scripts/*.mjs angular.json playwright.config.mjs eslint.config.mjs .prettierrc.json .postcssrc.json package.json",
    "format:check": "prettier --check \"app/client/**/*.{js,ts,cjs,mjs,html,css,json}\" scripts/*.mjs angular.json playwright.config.mjs eslint.config.mjs .prettierrc.json .postcssrc.json package.json",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "21.4.0",
    "@angular-eslint/eslint-plugin-template": "21.4.0",
    "@angular-eslint/template-parser": "21.4.0",
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler": "21.2.25",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/chrome": "0.3.7",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "rolldown": "^1.2.15",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "firebase": "^13.1.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  }
}
